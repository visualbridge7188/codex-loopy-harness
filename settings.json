{
  "env": {
    "TELEGRAM_BOT_TOKEN": "YOUR_BOT_TOKEN",
    "TELEGRAM_CHAT_ID": "YOUR_CHAT_ID",
    "PROJECT_NAME": "codex-loopy-harness"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Read",
      "Write",
      "Edit"
    ],
    "deny": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/context-enrichment.sh"
          },
          {
            "type": "command",
            "command": "hooks/skill-activation-prompt.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|replace_in_file|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/agent-permission-check.sh"
          },
          {
            "type": "command",
            "command": "hooks/no-localstorage.sh"
          },
          {
            "type": "command",
            "command": "hooks/auto-validate.sh"
          },
          {
            "type": "command",
            "command": "hooks/require-isPWA-check.sh"
          },
          {
            "type": "command",
            "command": "hooks/scaffold-violation-check.sh"
          },
          {
            "type": "command",
            "command": "hooks/post-tool-use-tracker.sh"
          },
          {
            "type": "command",
            "command": "hooks/error-handling-reminder.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/require-telegram-notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/session-cleanup.sh"
          }
        ]
      }
    ]
  }
}