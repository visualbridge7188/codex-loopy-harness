            "type": "guardrail",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Comprehensive frontend development guidelines — component patterns, styling, performance, routing, data fetching",
            "promptTriggers": {
                "keywords": [
                    "component pattern",
                    "styling guide",
                    "frontend performance",
                    "file organization",
                    "data fetching",
                    "frontend typescript",
                    "컴포넌트 패턴",
