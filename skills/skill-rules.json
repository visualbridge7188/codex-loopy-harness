                    "(react|next).*?(best practice|모범 사례)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "src/components/**/*.{tsx,ts}",
                    "src/pages/**/*.{tsx,ts}",
                    "src/app/**/*.{tsx,ts}"
