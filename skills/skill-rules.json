{
    "version": "2.0",
    "description": "Codex Loopy Harness - Skill activation triggers. Controls when skills automatically suggest or block actions based on user prompts and file edits.",
    "skills": {
        "team": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "critical",
            "description": "8-Phase SDLC orchestration pipeline for full development workflows",
            "promptTriggers": {
                "keywords": [
                    "개발 시작",
                    "프로젝트 시작",
                    "development workflow",
                    "SDLC",
                    "8 phase",
                    "파이프라인",
                    "pipeline",
                    "스프린트",
                    "sprint"
                ],
                "intentPatterns": [
                    "(시작|start|begin).*?(프로젝트|project|개발|development)",
                    "(실행|run|start).*?(팀|team|파이프라인|pipeline)",
                    "(develop|build|ship).*?(feature|project|app)"
                ]
            }
        },
        "init-project": {
